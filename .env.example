# ==============================================================================
# Family Photo Gallery — Environment Configuration
# ==============================================================================

# --- Authentication & Session Security ---
# Shared access code family members enter to unlock the album (case-sensitive)
FAMILY_ACCESS_CODE="our-secret-family-code-2025"

# Cryptographically strong secret key used to HMAC-sign session cookies (minimum 32 characters)
# Generate using: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-very-long-and-cryptographically-secure-random-string-min-32-chars"

# Session duration in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE_SECONDS=604800

# --- Cloudinary Credentials ---
# Found in Cloudinary Dashboard -> Programmable Media -> Dashboard / Settings
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Folder inside Cloudinary where family photographs are stored
# (Leave empty to fetch from root, or specify e.g. "family-album")
CLOUDINARY_FOLDER="family-album"

# Asset delivery type in Cloudinary: "upload" (standard), "authenticated", or "private"
# For heightened privacy where direct public URLs are strictly blocked by Cloudinary, use "authenticated"
CLOUDINARY_DELIVERY_TYPE="upload"

# --- Gallery Customization (Optional) ---
NEXT_PUBLIC_GALLERY_TITLE="The Family Album"
NEXT_PUBLIC_GALLERY_SUBTITLE="Private archive of our moments and memories"
